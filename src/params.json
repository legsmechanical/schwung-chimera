  {"name": "Ooh Choir", "values": {"mode": "Sing", "words": "Ooh", "female": 0.5, "breathy": 0.35, "vibrato": 45, "vib_rate": 5.2}},
  {"name": "Robot Diva", "values": {"mode": "Sing", "words": "Hello", "female": 1, "vibrato": 0, "drift": 0, "rough": 0, "pressed": 0.8, "bright": 0.6}},
  {"name": "Baritone La", "values": {"mode": "Sing", "words": "La", "larynx": 0.3, "breath": 11, "vibrato": 40}},
  {"name": "Vowel Pad", "values": {"mode": "Vowel", "vowel": "Ah", "sweep": 0.5, "press_amt": 0.5, "female": 0.5, "vibrato": 25, "glide": 120}},
  {"name": "Drone Ah", "values": {"mode": "Vowel", "vowel": "Ah", "sweep": 0.5, "hold": "On", "vibrato": 0, "glide": 200}},
  {"name": "Talk Box", "values": {"mode": "Vowel", "vowel": "Oh", "sweep": 0.25, "press_amt": 0.75, "bright": 0.7, "pressed": 0.75, "vibrato": 0, "glide": 20}},
  {"name": "Whisper", "values": {"mode": "Vowel", "vowel": "Ee", "sweep": 1, "press_amt": -0.5, "whisper": "On", "female": 1}},
  {"name": "Throat Singer", "values": {"mode": "Vowel", "vowel": "Er", "twang": 0.8, "false_folds": 0.6, "pressed": 0.85, "vibrato": 0}}
 ]
