{
 "_doc": "The ONE table of CHIMERA's parameters, pages and factory presets. tools/gen.mjs turns it into src/module.json (chain_params), src/dsp/params_gen.h (the plugin's table + ui_hierarchy) and engine/crates/chimera-move/src/params_gen.rs (ids). Page gates name modes (equals: Speak, lt: Vowel); the generator turns them into indices. Edit here, then run the generator (scripts/build.sh does). Param order is the id order: append, never reorder (saved states use keys, but ids must match on both sides of the build). 'artic' = the engine articulator a normalized 0..1 knob maps onto, over [lo, hi]; 'source' = a voice-source field; 'live' = the host reads <key>:effective every tick (the module moves it itself). A page's 'canvases' are its drawn pages (canvas.js), each before the page's knobs.",
 "modes": ["Speak", "Sing", "Vowel"],
 "params": [
  {"key": "mode", "name": "Mode", "type": "enum", "options": ["Speak", "Sing", "Vowel"], "short_options": ["SPK", "SNG", "VOW"], "default": 0},
  {"key": "words", "name": "Words", "type": "enum", "options": ["Custom", "Made of Air", "Twinkle", "Daisy Bell", "Hello", "Ah", "Ooh", "La", "Doo"], "short_options": ["OWN", "AIR", "TWN", "DSY", "HI", "AH", "OOH", "LA", "DOO"], "default": 1},
  {"key": "lyrics", "name": "Lyrics", "type": "string", "default": "Breathe in, breathe out, I am made of air. Tongue and lips and throat, singing anywhere."},
  {"key": "volume", "name": "Volume", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.8, "viz": {"kind": "fader"}},
  {"key": "female", "name": "Female", "short": "Fem", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0},
  {"key": "child", "name": "Child", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0},
  {"key": "breath", "name": "Breath", "type": "float", "min": 2, "max": 22, "step": 0.1, "unit": "cmH2O", "default": 8, "source": "pressure"},
  {"key": "pressed", "name": "Pressed", "short": "Press", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "source": "tension"},
  {"key": "vibrato", "name": "Vibrato", "type": "float", "min": 0, "max": 120, "step": 1, "unit": "cents", "default": 35},
  {"key": "vib_rate", "name": "Vib Rate", "short": "VRate", "type": "float", "min": 3, "max": 9, "step": 0.1, "unit": "Hz", "default": 6, "source": "vibrato_rate"},
  {"key": "glide", "name": "Glide", "type": "float", "min": 5, "max": 600, "step": 1, "unit": "ms", "default": 60, "source": "glide"},
  {"key": "hold", "name": "Hold", "type": "enum", "options": ["Off", "On"], "default": 0, "viz": {"kind": "switch"}},
  {"key": "bright", "name": "Bright", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.25, "source": "brightness"},
  {"key": "breathy", "name": "Breathy", "short": "Airy", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.15, "source": "breathiness"},
  {"key": "rough", "name": "Rough", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.1, "source": "roughness"},
  {"key": "fry", "name": "Fry", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "source": "fry"},
  {"key": "whisper", "name": "Whisper", "short": "Hush", "type": "enum", "options": ["Off", "On"], "default": 0, "viz": {"kind": "switch"}},
  {"key": "drift", "name": "Drift", "type": "float", "min": 0, "max": 20, "step": 0.1, "unit": "cents", "default": 5, "source": "drift"},
  {"key": "vowel", "name": "Pick Vowel", "type": "enum", "options": ["Ah", "Ee", "Ih", "Ay", "Eh", "Ae", "Aw", "Oh", "Uh", "Oo", "Book", "Er", "Schwa"], "ipa": ["ɑ", "i", "ɪ", "e", "ɛ", "æ", "ɔ", "o", "ʌ", "u", "ʊ", "ɝ", "ə"], "short_options": ["AH", "EE", "IH", "AY", "EH", "AE", "AW", "OH", "UH", "OO", "BK", "ER", "SCH"], "default": 0, "short": "Pick"},
  {"key": "tongue_x", "name": "Tng Front", "short": "Front", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["tbX", 1.0, 4.8]},
  {"key": "tongue_y", "name": "Tng High", "short": "Height", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["tbY", 4.8, 9.2]},
  {"key": "jaw", "name": "Jaw", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.25, "artic": ["jaw", 0.0, 2.4]},
  {"key": "lips", "name": "Lips Open", "short": "Lips", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.4, "artic": ["lipAp", -0.3, 2.2]},
  {"key": "round", "name": "Round", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["lipWidth", 1.0, 0.0]},
  {"key": "protrude", "name": "Protrude", "short": "Pout", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.2, "artic": ["lipProt", -0.1, 1.4]},
  {"key": "nasal", "name": "Nasal", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.07, "artic": ["velum", -0.25, 1.2]},
  {"key": "larynx", "name": "Larynx", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["larynx", -1.5, 1.5]},
  {"key": "twang", "name": "Twang", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["epilarynx", 0.0, 1.0]},
  {"key": "false_folds", "name": "False Fld", "short": "Folds", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["ventricular", 0.0, 1.0]},
  {"key": "tip_curl", "name": "Tip Curl", "short": "Curl", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["ttCurl", 0.0, 1.0]},
  {"key": "tongue_root", "name": "Tng Root", "short": "Root", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["root", -0.9, 0.9]},
  {"key": "lateral", "name": "Lateral", "short": "Side", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["lateral", 0.0, 1.0]},
  {"key": "rate", "name": "Rate", "type": "float", "min": 0.5, "max": 2, "step": 0.05, "unit": "x", "default": 1},
  {"key": "expression", "name": "Expression", "short": "Expr", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.35},
  {"key": "position", "name": "Position", "short": "Pos", "type": "int", "min": 0, "max": 255, "step": 1, "default": 0, "live": true, "_doc": "Sing: the syllable the next key sings (0 = the first). Live: answers the cursor, so the Lyrics page follows playing."},
  {"key": "sweep", "name": "Vowel", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "live": true, "_doc": "Vowel: a path through the vowels (Oo Oh Ah Eh Ee); turning it moves the Mouth knobs. Live: answers the position pad pressure has pushed it to."},
  {"key": "press_amt", "name": "Pressure", "short": "Push", "type": "float", "min": -1, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "_doc": "Vowel: how far, and which way, full pad pressure pushes the Vowel along its path."}
 ],
 "sweep_path": ["Oo", "Oh", "Ah", "Eh", "Ee"],
 "sweep_knobs": {"_doc": "the path as Mouth-knob values (male body) for the Vowel page's picture; from the engine: print_the_path_for_the_picture in tests/perform.rs", "keys": ["tongue_x", "tongue_y", "jaw", "lips", "round", "protrude"], "rows": [[0.373, 0.597, 0.085, 0.236, 0.935, 1.000], [0.137, 0.407, 0.278, 0.282, 0.973, 0.465], [0.269, 0.203, 0.702, 0.920, 0.000, 0.067], [0.632, 0.399, 0.434, 0.728, 0.000, 0.067], [0.706, 0.668, 0.172, 0.538, 0.000, 0.067]]},
 "pages": [
  {"level": "vowel", "label": "Vowel", "visible_if": {"param": "mode", "equals": "Vowel"}, "keys": ["sweep", "press_amt", "hold"], "canvases": [{"key": "mouth", "name": "Vowel"}]},
  {"level": "play", "label": "Play", "keys": ["mode", {"key": "words", "visible_if": {"param": "mode", "lt": "Vowel"}}, {"key": "lyrics", "visible_if": {"param": "mode", "lt": "Vowel"}}, {"key": "rate", "visible_if": {"param": "mode", "equals": "Speak"}}, {"key": "position", "visible_if": {"param": "mode", "equals": "Sing"}}, {"key": "expression", "visible_if": {"param": "mode", "equals": "Speak"}}, {"key": "vibrato", "visible_if": {"param": "mode", "not_equals": "Speak"}}, "female", "child", "volume"], "canvases": [{"key": "line", "name": "Line", "visible_if": {"param": "mode", "equals": "Speak"}, "view": true}, {"key": "sung", "name": "Lyrics", "visible_if": {"param": "mode", "equals": "Sing"}, "view": true}]},
  {"level": "mouth", "label": "Mouth", "visible_if": {"param": "mode", "equals": "Vowel"}, "keys": ["vowel", "tongue_x", "tongue_y", "jaw", "round", "lips", "protrude", "tip_curl"], "canvases": [{"key": "shape", "name": "Mouth"}]},
  {"level": "throat", "label": "Throat", "visible_if": {"param": "mode", "equals": "Vowel"}, "keys": ["larynx", "false_folds", "twang", "tongue_root", "nasal", "lateral"]},
  {"level": "tone", "label": "Tone", "keys": ["breath", "pressed", "bright", "breathy", "rough", "fry", "whisper", "drift"]},
  {"level": "pitch", "label": "Pitch", "visible_if": {"param": "mode", "not_equals": "Speak"}, "keys": ["vib_rate", {"key": "glide", "visible_if": {"param": "mode", "equals": "Vowel"}}]}
 ],
 "words": {
   "Made of Air": "Breathe in, breathe out, I am made of air. Tongue and lips and throat, singing anywhere.",
   "Twinkle": "Twinkle, twinkle, little star, how I wonder what you are.",
   "Daisy Bell": "Daisy, Daisy, give me your answer, do. I'm half crazy, all for the love of you.",
   "Hello": "Hello there, I am a voice made of air.",
   "Ah": "ah",
   "Ooh": "ooh",
   "La": "la",
   "Doo": "doo"
 },
 "presets": [
  {"name": "Spoken Word", "values": {"mode": "Speak", "words": "Made of Air"}},
  {"name": "Hello", "values": {"mode": "Speak", "words": "Hello", "female": 0.6}},
  {"name": "Quiet Voice", "values": {"mode": "Speak", "words": "Hello", "female": 1, "whisper": "On", "rate": 0.9}},
  {"name": "Auctioneer", "values": {"mode": "Speak", "words": "Daisy Bell", "rate": 1.8, "expression": 0.6, "pressed": 0.7}},
  {"name": "Made of Air", "values": {"mode": "Sing", "words": "Made of Air"}},
  {"name": "Twinkle Girl", "values": {"mode": "Sing", "words": "Twinkle", "female": 1, "vibrato": 30}},
