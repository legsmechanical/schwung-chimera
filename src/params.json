{
  "_doc": "The ONE table of CHIMERA's parameters, pages and factory presets. tools/gen.mjs turns it into src/module.json (chain_params), src/dsp/params_gen.h (the plugin's table + ui_hierarchy) and engine/crates/chimera-move/src/params_gen.rs (ids). Edit here, then run the generator (scripts/build.sh does). Param order is the id order: append, never reorder (saved states use keys, but ids must match on both sides of the build). 'artic' = the engine articulator a normalized 0..1 knob maps onto, over [lo, hi]; 'source' = a voice-source field; 'creature' = [creature id, param key] for a creature's own parameter.",
  "modes": ["Sing", "Vowel", "Beatbox", "Songbird", "Seal", "Gator", "Elephant"],
  "params": [
    {"key": "mode", "name": "Mode", "type": "enum", "options": ["Sing", "Vowel", "Beatbox", "Songbird", "Seal", "Gator", "Elephant"], "short_options": ["SNG", "VOW", "BBX", "BRD", "SEL", "GTR", "ELE"], "default": 0},
    {"key": "words", "name": "Words", "type": "enum", "options": ["Custom", "Made of Air", "Twinkle", "Daisy Bell", "Hello", "Ah", "Ooh", "La", "Doo"], "short_options": ["OWN", "AIR", "TWN", "DSY", "HI", "AH", "OOH", "LA", "DOO"], "default": 1},
    {"key": "lyrics", "name": "Lyrics", "type": "string", "default": "Breathe in, breathe out, I am made of air. Tongue and lips and throat, singing anywhere."},
    {"key": "restart", "name": "Restart", "short": "Again", "type": "enum", "options": ["-", "Go"], "access": "write", "default": 0},
    {"key": "pattern", "name": "Pattern", "short": "Beat", "type": "enum", "options": ["Off", "Boots & Cats", "Four Floor", "Breakbeat", "Rim Shuffle", "Inward", "Clicks", "Hum Bass"], "short_options": ["OFF", "BTS", "4FL", "BRK", "RIM", "INW", "CLK", "HUM"], "default": 1},
    {"key": "swing", "name": "Swing", "type": "float", "min": 0, "max": 0.6, "step": 0.01, "unit": "%", "default": 0},
    {"key": "volume", "name": "Volume", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.8},

    {"key": "female", "name": "Female", "short": "Fem", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0},
    {"key": "child", "name": "Child", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0},
    {"key": "breath", "name": "Breath", "type": "float", "min": 2, "max": 22, "step": 0.1, "unit": "cmH2O", "default": 8, "source": "pressure"},
    {"key": "pressed", "name": "Pressed", "short": "Press", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "source": "tension"},
    {"key": "vibrato", "name": "Vibrato", "type": "float", "min": 0, "max": 120, "step": 1, "unit": "cents", "default": 35},
    {"key": "vib_rate", "name": "Vib Rate", "short": "VRate", "type": "float", "min": 3, "max": 9, "step": 0.1, "unit": "Hz", "default": 6, "source": "vibrato_rate"},
    {"key": "glide", "name": "Glide", "type": "float", "min": 5, "max": 600, "step": 1, "unit": "ms", "default": 60, "source": "glide"},
    {"key": "hold", "name": "Hold", "type": "enum", "options": ["Off", "On"], "default": 0},

    {"key": "bright", "name": "Bright", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.25, "source": "brightness"},
    {"key": "breathy", "name": "Breathy", "short": "Airy", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.15, "source": "breathiness"},
    {"key": "rough", "name": "Rough", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.1, "source": "roughness"},
    {"key": "fry", "name": "Fry", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "source": "fry"},
    {"key": "whisper", "name": "Whisper", "short": "Hush", "type": "enum", "options": ["Off", "On"], "default": 0},
    {"key": "drift", "name": "Drift", "type": "float", "min": 0, "max": 20, "step": 0.1, "unit": "cents", "default": 5, "source": "drift"},

    {"key": "vowel", "name": "Vowel", "type": "enum", "options": ["Ah", "Ee", "Ih", "Ay", "Eh", "Ae", "Aw", "Oh", "Uh", "Oo", "Book", "Er", "Schwa"], "ipa": ["ɑ", "i", "ɪ", "e", "ɛ", "æ", "ɔ", "o", "ʌ", "u", "ʊ", "ɝ", "ə"], "short_options": ["AH", "EE", "IH", "AY", "EH", "AE", "AW", "OH", "UH", "OO", "BK", "ER", "SCH"], "default": 0},
    {"key": "tongue_x", "name": "Tng Front", "short": "Front", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["tbX", 1.0, 4.8]},
    {"key": "tongue_y", "name": "Tng High", "short": "Height", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["tbY", 4.8, 9.2]},
    {"key": "jaw", "name": "Jaw", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.25, "artic": ["jaw", 0.0, 2.4]},
    {"key": "lips", "name": "Lips Open", "short": "Lips", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.4, "artic": ["lipAp", -0.3, 2.2]},
    {"key": "round", "name": "Round", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["lipWidth", 1.0, 0.0]},
    {"key": "protrude", "name": "Protrude", "short": "Pout", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.2, "artic": ["lipProt", -0.1, 1.4]},
    {"key": "nasal", "name": "Nasal", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.07, "artic": ["velum", -0.25, 1.2]},

    {"key": "larynx", "name": "Larynx", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["larynx", -1.5, 1.5]},
    {"key": "twang", "name": "Twang", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["epilarynx", 0.0, 1.0]},
    {"key": "false_folds", "name": "False Fld", "short": "Folds", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["ventricular", 0.0, 1.0]},
    {"key": "tip_curl", "name": "Tip Curl", "short": "Curl", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["ttCurl", 0.0, 1.0]},
    {"key": "tongue_root", "name": "Tng Root", "short": "Root", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "artic": ["root", -0.9, 0.9]},
    {"key": "lateral", "name": "Lateral", "short": "Side", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "artic": ["lateral", 0.0, 1.0]},

    {"key": "sb_keys", "name": "Keys", "type": "enum", "options": ["Pitch", "Flute", "Trill", "Chirps", "Buzz"], "short_options": ["PIT", "FLU", "TRL", "CHP", "BUZ"], "default": 0},
    {"key": "sb_hold", "name": "Hold", "type": "enum", "options": ["Off", "On"], "default": 0},
    {"key": "sb_interval", "name": "Interval", "type": "float", "min": -12, "max": 12, "step": 1, "unit": "st", "default": 7, "creature": ["songbird", "interval"]},
    {"key": "sb_lr", "name": "L-Both-R", "short": "L/R", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "creature": ["songbird", "voices"]},
    {"key": "sb_drive", "name": "Drive", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.35, "creature": ["songbird", "drive"]},
    {"key": "sb_tension", "name": "Tension", "short": "Tense", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.4, "creature": ["songbird", "tension"]},
    {"key": "sb_pressure", "name": "Air Sac", "type": "float", "min": 0.1, "max": 2, "step": 0.01, "unit": "kPa", "default": 0.9, "creature": ["songbird", "pressure"]},
    {"key": "sb_purity", "name": "Purity", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.8, "creature": ["songbird", "purity"]},
    {"key": "sb_throat", "name": "Throat", "type": "float", "min": 0.05, "max": 2, "step": 0.01, "unit": "cm3", "default": 0.4, "creature": ["songbird", "oec"]},
    {"key": "sb_gape", "name": "Beak", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.55, "creature": ["songbird", "gape"]},
    {"key": "sb_pitch", "name": "Pitch", "type": "float", "min": 400, "max": 9000, "step": 1, "unit": "Hz", "default": 2600, "creature": ["songbird", "pitch"]},

    {"key": "se_keys", "name": "Keys", "type": "enum", "options": ["Pitch", "Trill", "Zap", "Whistle", "Chug"], "short_options": ["PIT", "TRL", "ZAP", "WHS", "CHG"], "default": 0},
    {"key": "se_hold", "name": "Hold", "type": "enum", "options": ["Off", "On"], "default": 0},
    {"key": "se_prate", "name": "Rate", "type": "float", "min": 2, "max": 60, "step": 0.1, "unit": "Hz", "default": 18, "creature": ["seal", "pulseRate"]},
    {"key": "se_pdepth", "name": "Depth", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.6, "creature": ["seal", "pulse"]},
    {"key": "se_duty", "name": "Duty", "type": "float", "min": 0.15, "max": 1, "step": 0.01, "unit": "%", "default": 0.55, "creature": ["seal", "duty"]},
    {"key": "se_bright", "name": "Bright", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.6, "creature": ["seal", "bright"]},
    {"key": "se_rough", "name": "Rough", "type": "float", "min": 0, "max": 0.8, "step": 0.01, "unit": "%", "default": 0.05, "creature": ["seal", "rough"]},
    {"key": "se_pressure", "name": "Breath", "type": "float", "min": 2, "max": 25, "step": 0.1, "unit": "cmH2O", "default": 10, "creature": ["seal", "pressure"]},
    {"key": "se_mouth", "name": "Mouth", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.35, "creature": ["seal", "mouth"]},
    {"key": "se_pitch", "name": "Pitch", "type": "float", "min": 40, "max": 6000, "step": 1, "unit": "Hz", "default": 900, "creature": ["seal", "pitch"]},

    {"key": "ga_keys", "name": "Keys", "type": "enum", "options": ["Pitch", "Bellow", "Growl", "Hiss", "Dance"], "short_options": ["PIT", "BEL", "GRL", "HIS", "DNC"], "default": 0},
    {"key": "ga_hold", "name": "Hold", "type": "enum", "options": ["Off", "On"], "default": 0},
    {"key": "ga_chaos", "name": "Chaos", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.75, "creature": ["alligator", "chaos"]},
    {"key": "ga_pressure", "name": "Breath", "type": "float", "min": 3, "max": 40, "step": 0.1, "unit": "cmH2O", "default": 18, "creature": ["alligator", "pressure"]},
    {"key": "ga_mouth", "name": "Mouth", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.02, "creature": ["alligator", "mouth"]},
    {"key": "ga_nostrils", "name": "Nostrils", "short": "Nose", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.8, "creature": ["alligator", "nostrils"]},
    {"key": "ga_hiss", "name": "Hiss", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "creature": ["alligator", "hiss"]},
    {"key": "ga_pitch", "name": "Pitch", "type": "float", "min": 12, "max": 120, "step": 0.1, "unit": "Hz", "default": 28, "creature": ["alligator", "pitch"]},

    {"key": "el_keys", "name": "Keys", "type": "enum", "options": ["Pitch", "Rumble", "Trumpet", "Squeak"], "short_options": ["PIT", "RMB", "TRP", "SQK"], "default": 0},
    {"key": "el_hold", "name": "Hold", "type": "enum", "options": ["Off", "On"], "default": 0},
    {"key": "el_trumpet", "name": "Trumpet", "short": "Brass", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0, "creature": ["elephant", "mode"]},
    {"key": "el_lip", "name": "Valve", "type": "float", "min": 150, "max": 900, "step": 1, "unit": "Hz", "default": 470, "creature": ["elephant", "lipPitch"]},
    {"key": "el_pressure", "name": "Breath", "type": "float", "min": 3, "max": 45, "step": 0.1, "unit": "cmH2O", "default": 16, "creature": ["elephant", "pressure"]},
    {"key": "el_trunk", "name": "Trunk", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 1, "creature": ["elephant", "trunk"]},
    {"key": "el_chaos", "name": "Chaos", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.2, "creature": ["elephant", "chaos"]},
    {"key": "el_pitch", "name": "Pitch", "type": "float", "min": 8, "max": 45, "step": 0.1, "unit": "Hz", "default": 14, "creature": ["elephant", "pitch"]},

    {"key": "quality", "name": "Quality", "short": "Engine", "type": "enum", "options": ["Light", "Full"], "default": 0},
    {"key": "latency", "name": "Latency", "short": "Buffer", "type": "enum", "options": ["Low", "Normal", "Safe"], "short_options": ["LOW", "NRM", "SAF"], "default": 1},
    {"key": "mic", "name": "Close Mic", "short": "Mic", "type": "enum", "options": ["Off", "On"], "default": 1}
  ],
  "pages": [
    {"level": "play", "label": "Play", "keys": [
      "mode",
      {"key": "words", "visible_if": {"param": "mode", "equals": 0}},
      {"key": "lyrics", "visible_if": {"param": "mode", "equals": 0}},
      {"key": "restart", "visible_if": {"param": "mode", "equals": 0}},
      {"key": "pattern", "visible_if": {"param": "mode", "equals": 2}},
      {"key": "swing", "visible_if": {"param": "mode", "equals": 2}},
      {"key": "mic", "visible_if": {"param": "mode", "equals": 2}},
      "volume"]},
    {"level": "voice", "label": "Voice", "visible_if": {"param": "mode", "lt": 3}, "keys": [
      "female", "child", "breath", "pressed", "vibrato", "vib_rate", "glide",
      {"key": "hold", "visible_if": {"param": "mode", "equals": 1}}]},
    {"level": "tone", "label": "Tone", "visible_if": {"param": "mode", "lt": 3}, "keys": ["bright", "breathy", "rough", "fry", "whisper", "drift"]},
    {"level": "mouth", "label": "Mouth", "visible_if": {"param": "mode", "equals": 1}, "keys": ["vowel", "tongue_x", "tongue_y", "jaw", "lips", "round", "protrude", "nasal"]},
    {"level": "throat", "label": "Throat", "visible_if": {"param": "mode", "equals": 1}, "keys": ["larynx", "twang", "false_folds", "tip_curl", "tongue_root", "lateral"]},
    {"level": "songbird", "label": "Songbird", "visible_if": {"param": "mode", "equals": 3}, "keys": ["sb_keys", "sb_hold", "sb_interval", "sb_lr", "sb_drive", "sb_tension", "sb_pressure", "sb_purity"]},
    {"level": "songbird2", "label": "Syrinx", "visible_if": {"param": "mode", "equals": 3}, "keys": ["sb_throat", "sb_gape", "sb_pitch"]},
    {"level": "seal", "label": "Seal", "visible_if": {"param": "mode", "equals": 4}, "keys": ["se_keys", "se_hold", "se_prate", "se_pdepth", "se_duty", "se_bright", "se_rough", "se_pressure"]},
    {"level": "seal2", "label": "Seal Mouth", "visible_if": {"param": "mode", "equals": 4}, "keys": ["se_mouth", "se_pitch"]},
    {"level": "gator", "label": "Gator", "visible_if": {"param": "mode", "equals": 5}, "keys": ["ga_keys", "ga_hold", "ga_chaos", "ga_pressure", "ga_mouth", "ga_nostrils", "ga_hiss", "ga_pitch"]},
    {"level": "elephant", "label": "Elephant", "visible_if": {"param": "mode", "equals": 6}, "keys": ["el_keys", "el_hold", "el_trumpet", "el_lip", "el_pressure", "el_trunk", "el_chaos", "el_pitch"]},
    {"level": "setup", "label": "Setup", "keys": ["quality", "latency"]}
  ],
  "words": {
    "Made of Air": "Breathe in, breathe out, I am made of air. Tongue and lips and throat, singing anywhere.",
    "Twinkle": "Twinkle, twinkle, little star, how I wonder what you are.",
    "Daisy Bell": "Daisy, Daisy, give me your answer, do. I'm half crazy, all for the love of you.",
    "Hello": "Hello there, I am a voice made of air.",
    "Ah": "ah",
    "Ooh": "ooh",
    "La": "la",
    "Doo": "doo"
  },
  "presets": [
    {"name": "Made of Air", "values": {"mode": "Sing", "words": "Made of Air"}},
    {"name": "Twinkle Girl", "values": {"mode": "Sing", "words": "Twinkle", "female": 1, "vibrato": 30}},
    {"name": "Daisy Child", "values": {"mode": "Sing", "words": "Daisy Bell", "child": 1, "vibrato": 20}},
    {"name": "Ooh Choir", "values": {"mode": "Sing", "words": "Ooh", "female": 0.5, "breathy": 0.35, "vibrato": 45, "vib_rate": 5.2}},
    {"name": "Robot Diva", "values": {"mode": "Sing", "words": "Hello", "female": 1, "vibrato": 0, "drift": 0, "rough": 0, "pressed": 0.8, "bright": 0.6}},
    {"name": "Baritone La", "values": {"mode": "Sing", "words": "La", "larynx": 0.3, "breath": 11, "vibrato": 40}},
    {"name": "Drone Ah", "values": {"mode": "Vowel", "vowel": "Ah", "hold": "On", "vibrato": 0, "glide": 200}},
    {"name": "Talk Box", "values": {"mode": "Vowel", "vowel": "Oh", "bright": 0.7, "pressed": 0.75, "vibrato": 0, "glide": 20}},
    {"name": "Whisper", "values": {"mode": "Vowel", "vowel": "Ee", "whisper": "On", "female": 1}},
    {"name": "Throat Singer", "values": {"mode": "Vowel", "vowel": "Er", "twang": 0.8, "false_folds": 0.6, "pressed": 0.85, "vibrato": 0}},
    {"name": "Boots & Cats", "values": {"mode": "Beatbox", "pattern": "Boots & Cats"}},
    {"name": "Breakbeat", "values": {"mode": "Beatbox", "pattern": "Breakbeat", "swing": 0.18}},
    {"name": "Hum Bass", "values": {"mode": "Beatbox", "pattern": "Hum Bass", "swing": 0.1}},
    {"name": "Songbird", "values": {"mode": "Songbird"}},
    {"name": "Canary Trills", "values": {"mode": "Songbird", "sb_keys": "Trill"}},
    {"name": "Seal Laser", "values": {"mode": "Seal", "se_keys": "Zap"}},
    {"name": "Seal Lead", "values": {"mode": "Seal", "se_pdepth": 0.2, "se_bright": 0.8}},
    {"name": "Gator Bellow", "values": {"mode": "Gator", "ga_keys": "Bellow"}},
    {"name": "Gator Sub", "values": {"mode": "Gator", "ga_hold": "Off", "ga_chaos": 0.4}},
    {"name": "Elephant Trumpet", "values": {"mode": "Elephant", "el_keys": "Trumpet"}},
    {"name": "Elephant Rumble", "values": {"mode": "Elephant"}}
  ]
}
