{
  "title": "CHIMERA Voice",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "A modeled voice:",
        "every sound comes",
        "from a simulated",
        "airway - lungs,",
        "vocal folds,",
        "tongue, lips, nose.",
        "No samples.",
        "",
        "One voice at a",
        "time. Mode: Speak,",
        "Sing or Vowel."
      ]
    },
    {
      "title": "Speak",
      "lines": [
        "A key speaks the",
        "whole of the lyrics",
        "at its pitch, with",
        "the rise and fall",
        "of speech: a ? ends",
        "high, a . falls.",
        "",
        "A new key starts",
        "the line again;",
        "letting go does",
        "not stop it.",
        "Velocity: breath.",
        "",
        "Rate: how fast.",
        "Expr: how much the",
        "pitch moves.",
        "",
        "Words: built-in",
        "lyrics. Lyrics:",
        "click to type your",
        "own."
      ]
    },
    {
      "title": "Sing",
      "lines": [
        "Each key sings the",
        "next syllable of",
        "the lyrics at its",
        "pitch.",
        "",
        "Hold a key while",
        "playing the next:",
        "legato. Velocity:",
        "breath.",
        "",
        "Pos: the syllable",
        "the next key sings.",
        "Turn it to start",
        "anywhere."
      ]
    },
    {
      "title": "Vowel",
      "lines": [
        "Keys set pitch and",
        "breathe; velocity:",
        "how hard.",
        "",
        "Vowel sweeps the",
        "mouth Oo Oh Ah Eh",
        "Ee. Pad pressure",
        "pushes it on, as",
        "far as Push says",
        "(below 0: back).",
        "",
        "Hold: drone with",
        "no key down.",
        "Mouth, Throat:",
        "shape it by hand.",
        "Pick: jump to one",
        "of 13 vowels."
      ]
    },
    {
      "title": "Settings",
      "lines": [
        "Engine and Buffer",
        "are set in Schwung",
        "Manager (move.local",
        ":7700, Modules,",
        "CHIMERA).",
        "",
        "Engine: Light runs",
        "a lighter airway",
        "(about 20% of a",
        "core). Full is the",
        "original (about",
        "60%; CM5 only).",
        "",
        "Buffer: Low 6 ms,",
        "Normal 12 ms, Safe",
        "23 ms. Raise it if",
        "you hear dropouts."
      ]
    }
  ]
}
